{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposureguard.dev/schemas/distribution-manifest.schema.json",
  "title": "ExposureGuard Engine Distribution Manifest",
  "type": "object",
  "required": ["distribution_schema_version", "engine", "engine_version", "engine_commit", "engine_binary_sha256", "protocol_version", "batch_protocol_version", "snapshot_schema_version", "identity_algorithm_version", "toolchain_manifest_sha256", "tools", "nuclei_templates_version", "nuclei_templates_sha256", "nuclei_ruleset_version", "nuclei_ruleset_sha256"],
  "properties": {
    "distribution_schema_version": {"const": "1"}, "engine": {"const": "exposureguard"},
    "engine_version": {"type": "string"}, "engine_commit": {"type": "string"},
    "engine_binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_version": {"const": "1"}, "batch_protocol_version": {"const": "1"},
    "snapshot_schema_version": {"const": "1"}, "identity_algorithm_version": {"const": "1"},
    "toolchain_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tools": {"type": "object", "required": ["subfinder", "httpx", "katana", "nuclei"], "additionalProperties": {"type": "object", "required": ["version", "binary_sha256"], "properties": {"version": {"type": "string"}, "binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "nuclei_templates_version": {"type": "string"}, "nuclei_templates_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nuclei_ruleset_version": {"type": "string"}, "nuclei_ruleset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
