{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposureguard.dev/schemas/protocol-v1/batch-result.schema.json",
  "title": "BatchResult",
  "description": "Aggregate terminal status for independent ScanRuns in a batch.",
  "type": "object",
  "required": ["batch_protocol_version", "batch_id", "status", "scan_count", "completed_count", "partial_count", "failed_count", "cancelled_count", "scans", "summary"],
  "properties": {
    "batch_protocol_version": { "type": "string", "const": "1" },
    "batch_id": { "type": "string", "format": "uuid" },
    "status": { "enum": ["complete", "partial", "failed", "cancelled"] },
    "scan_count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "completed_count": { "type": "integer", "minimum": 0 },
    "partial_count": { "type": "integer", "minimum": 0 },
    "failed_count": { "type": "integer", "minimum": 0 },
    "cancelled_count": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object",
      "required": ["total", "completed", "partial", "failed", "cancelled", "started_at", "finished_at", "duration", "assets", "observations", "findings", "changes", "engine_version", "git_commit"],
      "properties": {
        "total": { "type": "integer", "minimum": 1, "maximum": 20 },
        "completed": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "duration": { "type": "integer", "minimum": 0 },
        "assets": { "type": "integer", "minimum": 0 },
        "observations": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "changes": { "type": "integer", "minimum": 0 },
        "engine_version": { "type": "string" },
        "git_commit": { "type": "string" }
      }
    },
    "scans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["scan_id", "status"],
        "properties": {
          "scan_id": { "type": "string", "format": "uuid" },
          "status": { "enum": ["complete", "partial", "failed", "cancelled"] },
          "summary": { "type": "object" },
          "result": { "$ref": "scan-result.schema.json" },
          "error": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
