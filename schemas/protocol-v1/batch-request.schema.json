{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposureguard.dev/schemas/protocol-v1/batch-request.schema.json",
  "title": "BatchRequest",
  "description": "Batch Protocol v1 request; Engine owns scheduling and safe parallelism.",
  "type": "object",
  "required": ["batch_protocol_version", "batch_id", "scans"],
  "properties": {
    "batch_protocol_version": { "type": "string", "const": "1" },
    "batch_id": { "type": "string", "format": "uuid" },
    "limits": {
      "type": "object",
      "properties": {
        "max_batch_size": { "type": "integer", "minimum": 1, "maximum": 20, "default": 16 },
        "max_parallel_scans": { "type": "integer", "minimum": 1, "maximum": 4, "default": 4 },
        "max_parallel_external_processes": { "type": "integer", "minimum": 1, "maximum": 4, "default": 4 },
        "max_temp_bytes": { "type": "integer", "minimum": 16777216, "maximum": 268435456, "default": 268435456 },
        "max_output_bytes": { "type": "integer", "minimum": 1048576, "maximum": 67108864, "default": 67108864 }
      },
      "additionalProperties": false
    },
    "scans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/definitions/scanRequest" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "scanRequest": {
      "type": "object",
      "required": ["schema_version", "scan_id", "target"],
      "properties": {
        "schema_version": { "type": "string", "const": "1" },
        "scan_id": { "type": "string", "format": "uuid" },
        "target": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["public", "owned"] },
        "profile": { "type": "string", "enum": ["quick", "standard", "deep"] },
        "modules": { "type": "array", "items": { "type": "string" } },
        "disable_modules": { "type": "array", "items": { "type": "string" } },
        "integrations": { "type": "string" },
        "disable_integrations": { "type": "array", "items": { "type": "string" } },
        "require_integrations": { "type": "array", "items": { "type": "string" } },
        "limits": { "type": "object" },
        "previous_snapshot": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
