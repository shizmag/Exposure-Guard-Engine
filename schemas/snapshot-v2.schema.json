{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exposureguard.dev/schemas/snapshot-v2.schema.json",
  "title": "SnapshotV2",
  "description": "Normalized inventory with explicit successful-stage coverage for mixed-profile comparison (Schema v2)",
  "type": "object",
  "required": ["schema_version", "target", "coverage", "assets", "observations", "findings", "summary"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2"
    },
    "coverage": {
      "description": "Stages that completed successfully during this scan. An empty array means no stage completed successfully.",
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fingerprint": {
      "type": "string",
      "description": "Canonical SHA-256 hash of normalized snapshot state"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": ["raw", "url", "scheme", "host"],
      "properties": {
        "raw": { "type": "string" },
        "url": { "type": "string" },
        "scheme": { "type": "string" },
        "host": { "type": "string" },
        "domain": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "value", "coverage"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["hostname", "url", "javascript", "source_map", "endpoint_candidate", "external_reference"] },
          "value": { "type": "string" },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "discovered_via": { "type": "string" },
          "carried_forward": { "type": "boolean", "description": "True when the item remains in this profile baseline because one or more provenance stages did not complete in this scan." },
          "coverage": { "description": "Stages that have produced the item, including earlier same-profile observations.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "attributes": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "subject", "data", "coverage"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "subject": { "type": "string" },
          "coverage": { "description": "Stages that have produced the item, including earlier same-profile observations.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "carried_forward": { "type": "boolean", "description": "True when the item remains in this profile baseline because one or more provenance stages did not complete in this scan." },
          "data": { "type": "object" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "severity", "title", "asset", "coverage"],
        "properties": {
          "id": { "type": "string" },
          "check_id": { "type": "string" },
          "coverage": { "description": "Stages that have produced the item, including earlier same-profile observations.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "carried_forward": { "type": "boolean", "description": "True when the item remains in this profile baseline because one or more provenance stages did not complete in this scan." },
          "rule_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "asset": { "type": "string" },
          "evidence": { "type": "object" },
          "remediation": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_assets", "total_observations", "total_findings"],
      "properties": {
        "total_assets": { "type": "integer" },
        "total_observations": { "type": "integer" },
        "total_findings": { "type": "integer" },
        "critical_findings": { "type": "integer" },
        "high_findings": { "type": "integer" },
        "medium_findings": { "type": "integer" },
        "low_findings": { "type": "integer" },
        "info_findings": { "type": "integer" }
      }
    }
  },
  "additionalProperties": true
}
